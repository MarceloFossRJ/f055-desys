<%# A mailer is the one place the generated Ruby tokens are not optional.
    Email clients strip <style> blocks, so every rule has to be inline -- there
    is no Tailwind here and no stylesheet to link. f055_text() builds each
    declaration from the same token file the web app compiles its classes from,
    which is the only way the two stay in step. %>
<!doctype html>
<html>
  <body style="margin: 0; padding: 0; background: <%= f055_color(:muted) %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center" style="padding: <%= F055::Tokens::SPACING['24'] %>;">
          <table role="presentation" width="384" cellpadding="0" cellspacing="0" border="0"
                 style="width: 384px; max-width: 100%;
                        background: <%= f055_color(:card) %>;
                        border-radius: <%= F055::Tokens::RADIUS['24'] %>;
                        border: 1px solid <%= f055_color(:border) %>;">
            <tr>
              <td style="padding: <%= F055::Tokens::SPACING['24'] %>;">
                <h1 style="margin: 0 0 <%= F055::Tokens::SPACING['6'] %>;
                           <%= f055_text(:panel_title) %>">
                  Reset your password
                </h1>

                <p style="margin: 0 0 <%= F055::Tokens::SPACING['20'] %>;
                          <%= f055_text(:prose, color: :muted_foreground) %>">
                  Someone asked to reset the password for <%= @email %>. If that
                  was not you, nothing has changed and you can ignore this.
                </p>

                <%# A pill button in email: a table cell with a radius, because
                    an <a> with padding collapses in several clients. %>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="background: <%= f055_color(:primary) %>;
                               border-radius: <%= F055::Tokens::RADIUS['pill'] %>;
                               height: <%= f055_control(:button) %>;">
                      <a href="<%= @url %>"
                         style="display: inline-block;
                                padding: 0 <%= F055::Tokens::SPACING['16'] %>;
                                line-height: <%= f055_control(:button) %>;
                                text-decoration: none;
                                <%= f055_text(:button, color: :primary_foreground) %>">
                        Choose a new password
                      </a>
                    </td>
                  </tr>
                </table>

                <p style="margin: <%= F055::Tokens::SPACING['20'] %> 0 0;
                          <%= f055_text(:caption, color: :muted_foreground) %>">
                  This link expires in one hour.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
