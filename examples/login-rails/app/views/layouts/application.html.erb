<!doctype html>
<html lang="en" class="<%= theme == "dark" ? "dark" : "" %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Computed server side from the tokens -- a browser chrome colour cannot
        come from a stylesheet. This is the helper earning its place. %>
    <meta name="theme-color" content="<%= f055_color(:background, theme.to_sym) %>">
    <title><%= content_for(:title) || "F055" %></title>
    <link rel="stylesheet" href="/assets/fonts.css">
    <link rel="stylesheet" href="/assets/application.css">
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <%= yield %>
  </body>
</html>
